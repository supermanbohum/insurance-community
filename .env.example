# =========================================
# Supabase
# =========================================
# 로컬 개발(.env.local)과 운영(Vercel)은 서로 다른 파일/저장소로 완전히 분리되어 있다 -
# .env.local은 .gitignore에 있어 git에 올라가지 않고, Vercel 배포는 이 저장소의 어떤 .env
# 파일도 읽지 않는다(Vercel 프로젝트 대시보드 Settings → Environment Variables에 등록된
# 값만 사용). 즉 "개발 DB ↔ 운영 DB 전환"은 이미 파일 하나(.env.local)만 바꾸면 되는
# 구조다 - 진짜 필요한 건 서로 다른 Supabase 프로젝트 2개(개발용/운영용)뿐이다.
#
# 개발용 Supabase 프로젝트를 새로 만들면: 1) supabase/migrations/*.sql을 파일명 순서대로
# 그 프로젝트의 SQL Editor에서 실행 2) Authentication → Providers → Email → Confirm email
# 켜기 3) Authentication → URL Configuration → Redirect URLs에 http://localhost:3000/** 추가
# 4) 이 3개 값을 그 프로젝트 값으로 바꿔서 .env.local에 붙여넣기.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service role key는 절대 클라이언트에 노출되지 않습니다. 서버(Route Handler/서버 액션)에서만 사용됩니다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =========================================
# 보안 (IP 해시용 서버 비밀키 - 외부에 노출 금지)
# =========================================
IP_HASH_SECRET=change-this-to-a-long-random-string

# =========================================
# 관리자
# =========================================
# 최초 super_admin 지정용 이메일(선택, README 참고)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com

# =========================================
# 카카오
# =========================================
# 카카오톡 공유(Kakao.Share) 전용 JS 키(developers.kakao.com 앱 설정 → 플랫폼 → JavaScript
# 키). 공개 키라 클라이언트 노출이 정상이지만, 회전 시 재배포만으로 끝나도록 env로 뺐다.
# 카카오 로그인용 REST API 키(KAKAO_REST_API_KEY, 서버 전용)와는 다른 키다 - 헷갈리지 말 것.
NEXT_PUBLIC_KAKAO_JS_KEY=your-kakao-javascript-key

# =========================================
# 사이트 설정 (기본값 - site_settings 테이블로도 override 가능)
# =========================================
NEXT_PUBLIC_SITE_NAME=보험설계사 익명 커뮤니티
NEXT_PUBLIC_SITE_URL=https://example.com

# =========================================
# 환경 구분 / 개발용 데모 수치
# =========================================
# production | development | staging
NEXT_PUBLIC_APP_ENV=development
# true일 경우에만 개발/스테이징 환경에서 데모 표시 수치 사용 가능. production에서는 코드 레벨에서 강제로 무시됨.
ENABLE_DEMO_METRICS=false
